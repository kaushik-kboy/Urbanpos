#!/bin/sh
# UrbanPOS Automated Pre-Push Regression Guard
# Automatically blocks git push if core calculations or view compilation fails.

echo ""
echo "=========================================================="
echo " 🛡️  UrbanPOS Pre-Push Regression Guard Running..."
echo "=========================================================="

# 1. Check Blade Templates Syntax & Route Integrity
echo ">> Checking Blade template syntax & route integrity..."
php artisan view:clear > /dev/null 2>&1
php artisan view:cache > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ PUSH BLOCKED: Blade template syntax or compilation error detected!"
    echo "Run 'php artisan view:cache' manually to see the exact error."
    echo ""
    exit 1
fi
php vendor/bin/phpunit tests/Feature/BladeRouteIntegrityTest.php > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ PUSH BLOCKED: Invalid route() detected in Blade templates!"
    echo "Run 'php artisan test --filter=BladeRouteIntegrityTest' to see the invalid routes."
    echo ""
    exit 1
fi
echo "   ✓ Blade view templates and route integrity verified successfully."

# 2. Run Core POS Regression Test Suite
echo ">> Running Core POS Regression Test Suite (composer test-pos)..."
php vendor/bin/phpunit tests/Feature/CorePosRegressionTest.php
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "=========================================================="
    echo "❌ PUSH BLOCKED: Core POS Regression Tests Failed!"
    echo "A recent change broke existing calculations, stock logic, or preferences."
    echo "Please fix the failing tests before pushing to the repository."
    echo "=========================================================="
    echo ""
    exit 1
fi

# 3. Run Frontend & Keyboard/Modal Automated Tests (if vitest installed)
if [ -f "./node_modules/.bin/vitest" ] || [ -d "./node_modules/vitest" ]; then
    echo ">> Running Frontend & Keyboard/Modal Test Suite (npm run test:frontend)..."
    npm run test:frontend
    FRONTEND_EXIT_CODE=$?
    if [ $FRONTEND_EXIT_CODE -ne 0 ]; then
        echo ""
        echo "=========================================================="
        echo "❌ PUSH BLOCKED: Frontend / Keyboard / Modal Tests Failed!"
        echo "A recent change broke keyboard shortcuts or modal lifecycle."
        echo "=========================================================="
        echo ""
        exit 1
    fi
fi

# 4. Check Inline Blade JavaScript Syntax (Zero-Tolerance Guard)
echo ">> Checking inline Blade JavaScript syntax..."
node scripts/check-blade-js-syntax.cjs
BLADE_JS_EXIT_CODE=$?
if [ $BLADE_JS_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "=========================================================="
    echo "❌ PUSH BLOCKED: Inline JavaScript Syntax Error in Blade Template!"
    echo "Run 'node scripts/check-blade-js-syntax.cjs' to see the exact error."
    echo "=========================================================="
    echo ""
    exit 1
fi
echo "   ✓ Inline Blade JavaScript syntax verified successfully."

echo ""
echo "=========================================================="
echo " ✅ All Pre-Push Checks Passed (100% Green). Proceeding with push."
echo "=========================================================="
echo ""
exit 0
